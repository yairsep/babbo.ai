{
  "name": "babbo",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "fcdba8e723074729b8bbf56f0d3a3465"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "account_id": "c03ba416491dfb2921d0121555c539f8"
}
